{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": ".*\\.vercel\\.app" }
      ],
      "destination": "https://indianatlantichotel.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://rskpdgcshpbsupflgsiv.supabase.co/functions/v1/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
